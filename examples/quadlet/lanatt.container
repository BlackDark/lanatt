# /etc/containers/systemd/lanatt.container (rootful): the lanatt daemon.
# Least privilege, see docs/usage.md "Container image": three capabilities, AppArmor off
# because the default profile denies reading other users' /proc/<pid>/ns/net.
[Unit]
Description=lanatt: LAN attachments for rootless workloads
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/blackdark/lanatt:latest
ContainerName=lanatt
Network=host
PodmanArgs=--pid=host --security-opt=apparmor=unconfined
# Needed only with prefix6 or noSLAAC networks (sysctl writes): add --security-opt=unmask=/proc/sys
DropCapability=ALL
AddCapability=NET_ADMIN SYS_ADMIN SYS_PTRACE
NoNewPrivileges=true
ReadOnly=true
Volume=/etc/lanatt:/etc/lanatt:ro
Volume=/run/lanatt:/run/lanatt

[Service]
ExecStartPre=/usr/bin/mkdir -p /run/lanatt
Restart=on-failure

[Install]
WantedBy=multi-user.target
